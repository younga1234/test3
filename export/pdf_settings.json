  "inkscape_cli_examples": {
    "_comment": "Inkscape 명령줄 인터페이스 사용 예시",

    "example_1_basic_pdf": {
      "description": "기본 PDF 내보내기 (벡터 유지)",
      "command": "inkscape --export-type=pdf --export-filename=output.pdf input.svg"
    },

    "example_2_pdf_with_text_to_path": {
      "description": "텍스트를 패스로 변환하여 PDF 내보내기",
      "command": "inkscape --export-type=pdf --export-text-to-path --export-filename=output.pdf input.svg"
    },

    "example_3_pdf_version": {
      "description": "특정 PDF 버전으로 내보내기",
      "command": "inkscape --export-type=pdf --export-pdf-version=1.4 --export-text-to-path --export-filename=output.pdf input.svg"
    },

    "example_4_high_res_pdf": {
      "description": "고해상도 PDF 내보내기 (래스터 요소 포함 시)",
      "command": "inkscape --export-type=pdf --export-dpi=300 --export-text-to-path --export-filename=output.pdf input.svg"
    },

    "example_5_page_export": {
      "description": "전체 페이지 영역 내보내기",
      "command": "inkscape --export-type=pdf --export-area-page --export-text-to-path --export-filename=output.pdf input.svg"
    },

    "example_6_batch_export": {
      "description": "여러 파일 일괄 내보내기 (Bash 스크립트)",
      "command": "for file in *.svg; do inkscape --export-type=pdf --export-text-to-path --export-filename=\"${file%.svg}.pdf\" \"$file\"; done"
    },

    "example_7_png_export": {
      "description": "고해상도 PNG 내보내기 (웹 미리보기용)",
      "command": "inkscape --export-type=png --export-dpi=300 --export-filename=output.png input.svg"
    },

    "example_8_optimized_svg": {
      "description": "최적화된 SVG로 저장 (파일 크기 감소)",
      "command": "inkscape --export-type=svg --export-plain-svg --export-filename=output_optimized.svg input.svg"
    }
  },

